from __future__ import annotations

from datetime import date
from typing import Callable

import QuantLib as ql
import numpy as np

from instruments.components.cashflow_leg import CashflowLeg, LegType, SwapLeg  # noqa: F401 — re-export
from instruments.components.schedule_config import ScheduleConfig
from instruments.instrument import Instrument
from utils.ql_helpers import to_ql_date, generate_sub_periods, BUSINESS_CONVENTIONS
from market_data.yield_curve import YieldCurve
from market_data.risk_factor import CurveSlice, RiskFactorSlice
from models.cashflow_pv import leg_pv


# ---------------------------------------------------------------------------
# IRSwap
# ---------------------------------------------------------------------------

class IRSwap(Instrument):
    """Interest-rate swap priced against a ScenarioCube.

    Schedules are generated once at construction via QuantLib.
    On each call to :meth:`scenario_npvs`, a yield curve is built per path
    from the simulated curve factor in *market_state*, forward rates are
    computed for each accrual period, and cashflows are discounted.

    Supports LIBOR-style legs, overnight-compounded (OIS) legs such as
    ZARONIA or SOFR, sub-period resets with compounding/averaging, and
    fixed legs with optional sub-period compounding.
    """

    def __init__(
        self,
        name: str,
        effective_date: date,
        maturity_date: date,
        notional: float,
        receive_leg: SwapLeg,
        pay_leg: SwapLeg,
        discount_curve_name: str,
        interpolator: Callable,
        schedule_config: ScheduleConfig | None = None,
        # legacy flat params — used only when schedule_config is not supplied
        calendar: str = "ZAR",
        business_convention: str = "ModifiedFollowing",
        termination_business_convention: str = "ModifiedFollowing",
        date_generation: str = "Backward",
        day_count: str = "ACT/365",
        curve_day_count: str = "ACT/365",
        end_of_month: bool = False,
        include_sim_date_cashflows: bool = False,
    ):
        super().__init__(name)
        self.effective_date = effective_date
        self.maturity_date = maturity_date
        self.notional = notional
        self.receive_leg = receive_leg
        self.pay_leg = pay_leg
        self.discount_curve_name = discount_curve_name
        self.interpolator = interpolator
        self.include_sim_date_cashflows = include_sim_date_cashflows

        self.schedule_config = schedule_config or ScheduleConfig(
            calendar=calendar,
            business_convention=business_convention,
            termination_business_convention=termination_business_convention,
            date_generation=date_generation,
            day_count=day_count,
            curve_day_count=curve_day_count,
            end_of_month=end_of_month,
        )

        self._generate_schedules()

        # Quick curve_name → leg lookup used by compute_fixings / compute_cf_increment
        self._curve_to_leg: dict[str, CashflowLeg] = {}
        for leg in (self.receive_leg, self.pay_leg):
            if leg.leg_type == LegType.FLOATING and leg.curve_name:
                self._curve_to_leg[leg.curve_name] = leg

    # ------------------------------------------------------------------
    # schedule generation
    # ------------------------------------------------------------------

    def _generate_schedules(self):
        """Build QuantLib schedules and store accrual info for both legs."""
        self.receive_schedule = self.schedule_config.build(
            self.effective_date, self.maturity_date, self.receive_leg.frequency,
        )
        self.pay_schedule = self.schedule_config.build(
            self.effective_date, self.maturity_date, self.pay_leg.frequency,
        )

    # ------------------------------------------------------------------
    # reset / fixing interface
    # ------------------------------------------------------------------

    def get_reset_dates(self) -> list[tuple]:
        """Return reset tuples for all floating resets.

        For standard LIBOR legs returns 4-tuples:
            (reset_date, curve_name, period_start, period_end)

        For overnight-compounded (OIS) legs returns 5-tuples:
            (reset_date, curve_name, period_start, period_end, True)

        The ExposureEngine reads the optional 5th element to route the reset
        through the overnight compounding accumulator rather than the standard
        LIBOR fixing path.

        When ``reset_frequency_months`` is set, sub-period start dates are
        returned instead of payment-period start dates so that each sub-period
        rate is computed and cached separately.
        """
        resets: list[tuple] = []
        sc = self.schedule_config

        for schedule, leg in [
            (self.receive_schedule, self.receive_leg),
            (self.pay_schedule, self.pay_leg),
        ]:
            if leg.leg_type != LegType.FLOATING:
                continue

            if leg.overnight_compounding:
                # OIS: one reset per payment period (or per sub-period when
                # reset_frequency_months is set).  The engine accumulates the
                # overnight compound factor from period_start to sim_date.
                if leg.reset_frequency_months > 0:
                    for start, end, _ in schedule:
                        for sub_start, sub_end, _ in generate_sub_periods(
                            start, end, leg.reset_frequency_months,
                            sc.ql_calendar, ql.ModifiedFollowing,
                            sc.day_counter, direction="Backward",
                        ):
                            resets.append(
                                (sub_start, leg.curve_name, sub_start, sub_end, True)
                            )
                else:
                    for start, end, _ in schedule:
                        resets.append(
                            (start, leg.curve_name, start, end, True)
                        )

            elif leg.reset_frequency_months > 0:
                # Sub-period LIBOR: generate one fixing per sub-period so that
                # _leg_pv_compounded can read realized rates from the fixings dict.
                for start, end, _ in schedule:
                    for sub_start, sub_end, _ in generate_sub_periods(
                        start, end, leg.reset_frequency_months,
                        sc.ql_calendar, ql.ModifiedFollowing,
                        sc.day_counter, direction="Backward",
                    ):
                        resets.append((sub_start, leg.curve_name, sub_start, sub_end))

            else:
                # Standard LIBOR: one reset per payment period
                for start, end, _ in schedule:
                    resets.append((start, leg.curve_name, start, end))

        return resets

    def compute_fixings(
        self,
        resets: list[tuple[date, str, date, date]],
        time_slice: dict[str, RiskFactorSlice],
        scenario_date: date,
    ) -> dict[tuple[str, date], np.ndarray]:
        """Compute forward rates for the given resets from an earlier scenario's curve.

        Respects ``fixing_tenor_months`` and ``forward_business_convention`` on
        the leg so that stub periods and non-standard index tenors are handled
        consistently with :func:`leg_pv`.  The forward rate tau uses the coupon
        day-count convention (``day_counter``) while the discount-factor end
        tenor uses the curve day-count convention (``curve_day_counter``),
        matching the split used in ``_compute_forward_tenors``.
        """
        fixings: dict[tuple[str, date], np.ndarray] = {}
        ql_scenario = to_ql_date(scenario_date)
        sc = self.schedule_config

        for _reset_date, curve_name, p_start, p_end in resets:
            fwd_slice: CurveSlice = time_slice[curve_name]
            fwd_curve = YieldCurve(
                year_fracs=fwd_slice.tenors,
                rates=fwd_slice.values,
                interpolator=self.interpolator,
            )
            t_start = sc.curve_day_counter.yearFraction(
                ql_scenario, to_ql_date(p_start),
            )

            leg = self._curve_to_leg.get(curve_name)
            ql_start = to_ql_date(p_start)

            if leg is not None and leg.fixing_tenor_months is not None:
                # Fixed-tenor index (e.g. JIBAR-3m): advance from period start
                # by the index tenor regardless of the schedule period length.
                fwd_conv = (
                    BUSINESS_CONVENTIONS[leg.forward_business_convention]
                    if leg.forward_business_convention
                    else ql.ModifiedFollowing
                )
                ql_fwd_end = sc.ql_calendar.advance(
                    ql_start,
                    ql.Period(leg.fixing_tenor_months, ql.Months),
                    fwd_conv,
                )
                t_end = sc.curve_day_counter.yearFraction(ql_scenario, ql_fwd_end)
                fwd_tau = sc.day_counter.yearFraction(ql_start, ql_fwd_end)

            elif leg is not None and leg.forward_business_convention is not None:
                # Non-standard business convention for the forward end date
                fwd_conv = BUSINESS_CONVENTIONS[leg.forward_business_convention]
                ql_fwd_end = sc.ql_calendar.advance(
                    ql_start,
                    ql.Period(leg.frequency, ql.Months),
                    fwd_conv,
                )
                t_end = sc.curve_day_counter.yearFraction(ql_scenario, ql_fwd_end)
                fwd_tau = sc.day_counter.yearFraction(ql_start, ql_fwd_end)

            else:
                ql_end = to_ql_date(p_end)
                t_end = sc.curve_day_counter.yearFraction(ql_scenario, ql_end)
                fwd_tau = sc.day_counter.yearFraction(ql_start, ql_end)

            rate = fwd_curve.forward_rate(t_start, t_end, tau=fwd_tau)
            fixings[(curve_name, p_start)] = rate

        return fixings

    def compute_cf_increment(
        self,
        curve_name: str,
        t_j: date,
        t_j1: date,
        fix_slice: dict[str, RiskFactorSlice],
    ) -> np.ndarray:
        """Overnight compound factor for the interval [t_j, t_j1].

        Called by the ExposureEngine at each simulation step for OIS legs.
        Uses the forward (OIS) curve from the scenario state at t_j to
        compute DF(t_j→t_j1) = 1 / discount_factor(Δt), giving the
        single-period compound factor that accumulates into CF_realized.

        Parameters
        ----------
        curve_name : str
            The OIS curve risk-factor name (e.g. ``"InterestRate.ZARONIA"``).
        t_j, t_j1 : date
            Start and end of the overnight interval (consecutive scenario dates).
        fix_slice : dict
            Market state at t_j (from the scenario cube at that step).

        Returns
        -------
        np.ndarray, shape (n_paths,)
            Compound factor = 1 / DF(t_j → t_j1) per path.
        """
        fwd_slice: CurveSlice = fix_slice[curve_name]
        fwd_curve = YieldCurve(
            year_fracs=fwd_slice.tenors,
            rates=fwd_slice.values,
            interpolator=self.interpolator,
        )
        dt = float(self.schedule_config.curve_day_counter.yearFraction(
            to_ql_date(t_j), to_ql_date(t_j1),
        ))
        return 1.0 / fwd_curve.discount_factor(dt)

    # ------------------------------------------------------------------
    # pricing
    # ------------------------------------------------------------------

    def scenario_npvs(
        self,
        val_date: date,
        market_state: dict[str, RiskFactorSlice],
        fixings: dict[tuple[str, date], np.ndarray] | None = None,
        rng: np.random.Generator | None = None,
    ) -> np.ndarray:
        disc_slice: CurveSlice = market_state[self.discount_curve_name]
        n_paths = disc_slice.values.shape[0]

        if val_date > self.maturity_date:
            return np.zeros(n_paths)

        discount_curve = YieldCurve(
            year_fracs=disc_slice.tenors,
            rates=disc_slice.values,
            interpolator=self.interpolator,
        )

        sc = self.schedule_config
        common_kwargs = dict(
            notional=self.notional,
            val_date=val_date,
            market_state=market_state,
            discount_curve=discount_curve,
            n_paths=n_paths,
            interpolator=self.interpolator,
            day_counter=sc.day_counter,
            curve_day_counter=sc.curve_day_counter,
            calendar=sc.ql_calendar,
            fixings=fixings,
            include_on_val_date=self.include_sim_date_cashflows,
        )

        rec_pv = leg_pv(self.receive_schedule, self.receive_leg, **common_kwargs)
        pay_pv = leg_pv(self.pay_schedule, self.pay_leg, **common_kwargs)

        return rec_pv - pay_pv
