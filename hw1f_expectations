for p, dep in walk(root):
    fd = dep.Factor_dep or {}
    cf = fd.get("Cashflows")
    R = getattr(cf, "Resets", None)
    if R is None:
        continue
    ref = dep.Instrument.field.get("Reference", "")
    fwd = dep.Instrument.field.get("Forecast_Rate", "")
    span = R[:, 4] - R[:, 3]                       # End_Day - Start_Day
    print(f"{ref:<24} fwd={str(fwd):<28} "
          f"compound={fd.get('CompoundingMethod')} avg={fd.get('AveragingMethod')} "
          f"n_resets={len(R):<6} span={sorted(set(span.astype(int)))[:4]} "
          f"weight={R[0,5]:.6f} accrual={R[0,7]:.6f}")
