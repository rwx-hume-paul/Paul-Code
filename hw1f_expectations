
class MalzVol:
    """Volatility surface parameterized by (delta, tenor).

    The surface is supplied as a list of [delta, tenor, vol] triples.  Delta
    values serve as the moneyness axis; interpolation at a given strike and
    forward uses log-moneyness x = ln(F / K) against that axis.

    Interpolation scheme
    --------------------
    - **Tenor** : linear in total variance (sigma^2 * T).
    - **Delta** : linear in x = ln(F / K) against the stored delta coordinates.
    - **Extrapolation** : flat in both dimensions.

    Parameters
    ----------
    surface : list of [delta, tenor, vol]
        Raw surface points.  Multiple rows may share the same tenor (they
        define the smile for that expiry) or the same delta (they trace a
        term structure for that moneyness level).
    """

    def __init__(self, surface: list) -> None:
        arr = np.array(surface, dtype=np.float64)  # shape (N, 3): [delta, tenor, vol]

        self._tenors = np.unique(arr[:, 1])

        # For each tenor pillar store sorted (deltas, vols) arrays
        self._pillars: dict[float, tuple[np.ndarray, np.ndarray]] = {}
        for t in self._tenors:
            rows = arr[arr[:, 1] == t]
            order = np.argsort(rows[:, 0])
            self._pillars[float(t)] = (rows[order, 0], rows[order, 2])

    # ------------------------------------------------------------------
    # helpers
    # ------------------------------------------------------------------

    def _vol_at_pillar(
        self, t: float, x: float | np.ndarray
    ) -> float | np.ndarray:
        """Interpolate (flat-extrapolate) vol in the delta dimension at pillar *t*."""
        deltas, vols = self._pillars[t]
        return np.interp(x, deltas, vols)

    # ------------------------------------------------------------------
    # public API
    # ------------------------------------------------------------------

    def get_vol(
        self,
        strike: float | np.ndarray,
        forward: float | np.ndarray,
        tenor: float,
    ) -> float | np.ndarray:
        """Return implied volatility by 2-D interpolation.

        Parameters
        ----------
        strike : float or array
            Option strike price(s).
        forward : float or array
            Risk-neutral forward price(s) at option expiry.
        tenor : float
            Time to expiry in year fractions.

        Returns
        -------
        float or np.ndarray
            Implied volatility, same shape as *strike* / *forward*.
        """
        x = np.log(forward / strike)

        tenors = self._tenors
        idx = int(np.searchsorted(tenors, tenor))

        # Flat extrapolation before the first pillar
        if idx == 0:
            return self._vol_at_pillar(float(tenors[0]), x)

        # Flat extrapolation beyond the last pillar
        if idx == len(tenors):
            return self._vol_at_pillar(float(tenors[-1]), x)

        t2 = float(tenors[idx])

        # Exactly on a tenor pillar — no tenor interpolation needed
        if np.isclose(tenor, t2):
            return self._vol_at_pillar(t2, x)

        # Tenor lies strictly between two pillars
        t1 = float(tenors[idx - 1])
        vol1 = self._vol_at_pillar(t1, x)
        vol2 = self._vol_at_pillar(t2, x)

        # Interpolate linearly in total-variance space
        var1 = vol1 ** 2 * t1
        var2 = vol2 ** 2 * t2
        w = (tenor - t1) / (t2 - t1)
        var = var1 + w * (var2 - var1)

        return np.sqrt(np.maximum(var, 0.0) / tenor)

