

def generate_sub_periods(
    start: date,
    end: date,
    freq_months: int,
    calendar: ql.Calendar,
    convention: int,
    day_counter: ql.DayCounter,
    direction: str = "Backward",
) -> list[tuple[date, date, float]]:
    """Split a single accrual period into sub-periods of *freq_months*.

    Used for sub-period resets on floating legs (``reset_frequency_months``)
    and sub-period compounding on fixed legs (``compounding_period_months``).

    Parameters
    ----------
    start, end : date
        Endpoints of the payment period to be split.
    freq_months : int
        Sub-period length in months.  When ``<= 0``, or when it is at least
        as long as the period itself, the period is returned unsplit.
    calendar : ql.Calendar
        Calendar used to adjust the generated intermediate dates.
    convention : int
        Business day convention applied to intermediate dates.
    day_counter : ql.DayCounter
        Convention used for each sub-period's accrual fraction.
    direction : {"Backward", "Forward"}
        ``"Backward"`` anchors the roll on *end* so any short stub lands at
        the front of the period; ``"Forward"`` anchors on *start* so the
        stub lands at the back.

    Returns
    -------
    list of (sub_start, sub_end, accrual_fraction)
        Contiguous sub-periods spanning ``[start, end]``.
    """
    if freq_months <= 0 or start >= end:
        accrual = day_counter.yearFraction(to_ql_date(start), to_ql_date(end))
        return [(start, end, accrual)]

    ql_schedule = ql.Schedule(
        to_ql_date(start),
        to_ql_date(end),
        ql.Period(freq_months, ql.Months),
        calendar,
        convention,
        convention,
        DATE_GENERATION[direction],
        False,
    )

    subs: list[tuple[date, date, float]] = []
    for i in range(1, len(ql_schedule)):
        sub_start = ql_schedule[i - 1]
        sub_end = ql_schedule[i]
        subs.append((
            from_ql_date(sub_start),
            from_ql_date(sub_end),
            day_counter.yearFraction(sub_start, sub_end),
        ))

    return subs
