
def load_full_grid_mtm_from_results(
    json_path: str,
    overrides: dict,
) -> pd.DataFrame:
    """Extract RiskFlow GrossMTM at ALL simulation dates.

    Unlike load_mtm_dataframe_from_results (which returns the Time_grid
    report dates only), this reads cr["GrossMTM"][0] at the full internal
    time_grid.mtm_dates — which includes dates added via Dynamic_Scenario_Dates
    such as Asian option averaging dates.

    Returns
    -------
    pd.DataFrame
        Index   : datetime.date, one row per simulation date
        Columns : int, 0-based path index
    """
    cx = rf.Context()
    cx.load_json(json_path)
    calc, out = cx.run_job(overrides=overrides)

    cr        = out["Netting"].sub_structures[0].obj.Calc_res
    all_dates = sorted(calc.time_grid.mtm_dates)
    gross_mtm = cr["GrossMTM"][0]          # (n_all_dates, n_paths)

    return pd.DataFrame(
        gross_mtm,
        index   = [d.date() for d in all_dates],
        columns = range(gross_mtm.shape[1]),
    )
