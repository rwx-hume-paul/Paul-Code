
    def get_ois_compounded_cashflow_factor(self, start_date: date, end_date: date) -> float:
        """
        Returns the OIS compounded growth factor (DF(t1)/DF(t2) - 1) for a period.

        Represents the total compounded return from daily overnight fixings,
        derived from the discount curve rather than stepping through individual days.
        Multiply by notional to get the raw compounded cashflow.

        Parameters:
            start_date: Start date of the compounding period.
            end_date: End date of the compounding period.

        Returns:
            Compounded cashflow factor: DF(t1)/DF(t2) - 1.
        """
        if end_date <= start_date:
            raise ValueError("end_date must be greater than start_date")
        df1 = self.get_discount_factor_for_date(start_date)
        df2 = self.get_discount_factor_for_date(end_date)
        return df1 / df2 - 1.0

    def get_ois_compounded_rate(self, start_date: date, end_date: date) -> float:
        """
        Returns the OIS compounded rate (annualized) for a period.

        Equivalent to daily-compounded overnight rates expressed as an annualized
        simple rate: (DF(t1)/DF(t2) - 1) / tau. Compatible with add_floating_cashflows
        so that cashflow = N * tau * rate = N * (DF1/DF2 - 1).

        Parameters:
            start_date: Start date of the compounding period.
            end_date: End date of the compounding period.

        Returns:
            Annualized OIS compounded rate.
        """
        if end_date <= start_date:
            raise ValueError("end_date must be greater than start_date")
        tau = self.day_count_convention(start_date, end_date)
        return self.get_ois_compounded_cashflow_factor(start_date, end_date) / tau
