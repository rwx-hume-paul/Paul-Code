import numpy as np
import matplotlib.pyplot as plt

# ── input data ────────────────────────────────────────────────────────────────
tenors = np.array([0.25, 0.5, 1.0, 2.0, 3.0, 5.0])   # years
rates  = np.array([0.03, 0.032, 0.035, 0.038, 0.040, 0.042])  # dividend yield


def interp_reciprocal_time(tenors: np.ndarray, rates: np.ndarray,
                           query: np.ndarray) -> np.ndarray:
    """Interpolate rates linearly in reciprocal-time space (1/t).

    Transforms tenors to x = 1/t, performs linear interpolation on (x, rate),
    then maps back.  Outside the knot range the nearest rate is used (flat
    extrapolation), consistent with the reciprocal_time_interp convention used
    in yield-curve bootstrapping.
    """
    x_knots  = 1.0 / tenors          # reciprocal-time knot grid
    x_query  = 1.0 / np.maximum(query, 1e-10)

    # np.interp extrapolates flat beyond the range
    return np.interp(x_query, x_knots[::-1], rates[::-1])


# ── build a fine query grid and interpolate ───────────────────────────────────
t_fine  = np.linspace(tenors[0], tenors[-1], 500)
r_interp = interp_reciprocal_time(tenors, rates, t_fine)

# ── plot ──────────────────────────────────────────────────────────────────────
fig, ax = plt.subplots(figsize=(9, 5))

ax.plot(t_fine, r_interp * 100, color="steelblue", linewidth=2,
        label="Linear-on-reciprocal-time interpolation")
ax.scatter(tenors, rates * 100, color="firebrick", zorder=5,
           label="Input knot points")

ax.set_xlabel("Tenor (years)")
ax.set_ylabel("Dividend yield (%)")
ax.set_title("Dividend yield curve — reciprocal-time interpolation")
ax.legend()
ax.grid(True, linestyle="--", alpha=0.5)
plt.tight_layout()
plt.show()
