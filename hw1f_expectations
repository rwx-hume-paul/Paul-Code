    @staticmethod
    def _reset_boundary(instrument, d: date) -> date:
        """The date through which resets have fixed as at *d*.

        The next business day at or after *d* on the leg's calendar, or *d*
        unchanged when the instrument exposes no calendar.
        """
        calendar = getattr(
            getattr(instrument, "schedule_config", None), "ql_calendar", None,
        )
        if calendar is None:
            return d
        return next_business_day_on_or_after(d, calendar)
