import numpy as np

import numpy as np
import pandas as pd

FACTOR = "InterestRate.HKD-OIS"

def scenarios_to_array(out, factor=FACTOR):
    """
    RiskFlow scenarios DataFrame -> (dates, tenors, rates[t, tenor, scenario])
    """
    scen = out["Results"]["scenarios"][factor]  # index=(tenor,scenario), cols=dates
    if not isinstance(scen.index, pd.MultiIndex):
        raise ValueError("Expected MultiIndex (tenor, scenario).")
    tenors = np.array(sorted(pd.to_numeric(scen.index.get_level_values("tenor").unique())), dtype=float)
    scenarios = np.array(sorted(pd.to_numeric(scen.index.get_level_values("scenario").unique())), dtype=int)
    dates = pd.to_datetime(scen.columns)

    mats = []
    for tau in tenors:
        block = scen.xs(tau, level="tenor").reindex(scenarios)
        mats.append(block.to_numpy().T)  # (time, scenario)
    rates = np.stack(mats, axis=1)      # (time, tenor, scenario)
    return dates, tenors, rates

def z_interp(a_tenors, a_rates):
    return lambda u: np.interp(u, a_tenors, a_rates, left=a_rates[0], right=a_rates[-1])

def p0_ratio(z0, t, tau):
    return np.exp(-z0(t + tau) * (t + tau) + z0(t) * t)

def hw2_B(alpha, tau):
    return (1.0 - np.exp(-alpha * tau)) / alpha

def hw2_varX(alpha, sigma, t):
    # OU variance for factor X_t with constant sigma
    return sigma * sigma * (1.0 - np.exp(-2.0 * alpha * t)) / (2.0 * alpha)

def hw2_covX(alpha1, alpha2, sigma1, sigma2, rho, t):
    # Covariance between two OU factors with constant sigmas
    return rho * sigma1 * sigma2 * (1.0 - np.exp(-(alpha1 + alpha2) * t)) / (alpha1 + alpha2)

def hw2_expectations_from_sims(out, a_tenors, a_rates, factor=FACTOR):
    """
    Empirical mean/variance of Y(t,tau)=exp(-tau*R(t,tau)).
    Also returns P(0,T)/P(0,t) for comparison.
    """
    dates, tenors, sim_rates = scenarios_to_array(out, factor)
    t_years = ((dates - dates[0]).days / 365.0).to_numpy(dtype=float)
    z0 = z_interp(a_tenors, a_rates)

    rows = []
    for i, t in enumerate(t_years):
        lhs = np.array([p0_ratio(z0, t, tau) for tau in tenors])
        Y = np.exp(-tenors.reshape(-1, 1) * sim_rates[i, :, :])  # (tenor, scenario)
        mean_sim = Y.mean(axis=1)
        var_sim = Y.var(axis=1, ddof=1)
        rows.append({
            "date": dates[i],
            "t": t,
            "lhs_P0T_over_P0t": lhs,
            "mean_sim": mean_sim,
            "var_sim": var_sim,
            "ratio_mean": np.divide(mean_sim, lhs, out=np.full_like(lhs, np.nan), where=lhs>0),
        })
    return tenors, rows

def hw2_theoretical_var(
    tenors, t, a_tenors, a_rates,
    alpha1, sigma1, alpha2, sigma2, rho
):
    """
    Optional closed-form variance for Y(t,tau)=exp(-tau*R(t,tau))
    under 2-factor OU with constant sigmas.
    """
    z0 = z_interp(a_tenors, a_rates)
    lhs = np.array([p0_ratio(z0, t, tau) for tau in tenors])

    b1 = hw2_B(alpha1, tenors)
    b2 = hw2_B(alpha2, tenors)

    v1 = hw2_varX(alpha1, sigma1, t)
    v2 = hw2_varX(alpha2, sigma2, t)
    c12 = hw2_covX(alpha1, alpha2, sigma1, sigma2, rho, t)

    # Var of (b1*X1 + b2*X2)
    v = (b1**2) * v1 + (b2**2) * v2 + 2.0 * b1 * b2 * c12

    # If Y = (P0T/P0t) * exp(- (b1 X1 + b2 X2)), then
    # Var[Y] = (P0T/P0t)^2 * (exp(v) - 1)
    return lhs**2 * (np.exp(v) - 1.0)

