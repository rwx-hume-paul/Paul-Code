
    def compound_factor(self, t_schedule: np.ndarray) -> np.ndarray:
        """Cumulative overnight compound factor over a business-day schedule.

        Multiplies the one-day forward factors DF(t_i)/DF(t_{i+1}) across
        consecutive business days.  That product telescopes exactly to
        DF(t_first) / DF(t_last), so only the endpoints are evaluated — the
        interior days still matter because *t_schedule* has already snapped
        them to business days (a Friday entry is followed by Monday, so the
        three-day weekend accrual is captured automatically).

        Parameters
        ----------
        t_schedule : np.ndarray, shape (n_days,)
            Ascending year fractions to each business day in the compounding
            window, as built by ``_build_overnight_tenors``.

        Returns
        -------
        np.ndarray, shape (n_paths,)
            Compound factor per path.  A schedule with fewer than two entries
            spans no overnight interval and returns 1 (the empty product).
        """
        t_schedule = np.asarray(t_schedule, dtype=np.float64)
        n_paths = self.rates.shape[0]

        if t_schedule.size < 2:
            return np.ones(n_paths)

        df_first = self.discount_factor(float(t_schedule[0]))
        df_last = self.discount_factor(float(t_schedule[-1]))
        return df_first / df_last

    def forward_compounded_overnight_rate(
        self,
        t_schedule_start: np.ndarray,
        t_schedule_end: np.ndarray,
        tau: float | np.ndarray,
    ) -> np.ndarray:
        """Forward compounded overnight rate for one accrual period.

        Both schedules are measured from the same origin (the valuation
        date), giving the cumulative compound factors CF(origin -> t_start)
        and CF(origin -> t_end).  The period's compounded rate is then

            R = (CF_end / CF_start - 1) / tau

        For the first period, where the period start coincides with the
        origin, CF_start is the empty product 1 and this reduces to the spot
        compounded overnight rate.

        Parameters
        ----------
        t_schedule_start : np.ndarray
            Business-day year fractions from the origin to the period start.
        t_schedule_end : np.ndarray
            Business-day year fractions from the origin to the period end.
        tau : float or np.ndarray
            Accrual fraction in the coupon's own day-count convention.

        Returns
        -------
        np.ndarray, shape (n_paths,)
        """
        cf_start = self.compound_factor(t_schedule_start)
        cf_end = self.compound_factor(t_schedule_end)
        return (cf_end / cf_start - 1.0) / np.asarray(tau)
