from __future__ import annotations

from datetime import date

import numpy as np

from instruments.instrument import Instrument
from instruments.ir_swap import IRSwap
from instruments.components.cashflow_leg import LegType
from market_data.vol_surface import IRVol
from market_data.yield_curve import YieldCurve
from market_data.risk_factor import CurveSlice, RiskFactorSlice
from models.cashflow_pv import filter_future_periods, compute_period_year_fractions
from models.equity_pv import black76_euro_option
from utils.ql_helpers import to_ql_date


# Floor applied to the SHIFTED forward/strike so the Black log stays defined
# when the supplied shift is too small to lift them above zero.  Purely a
# numerical guard — with an adequate shift it never binds.
_RATE_FLOOR = 1e-5


class Swaption(Instrument):
    """European swaption valued with Black-76.

    Wraps an underlying IRSwap.  All trade parameters (notional, schedules,
    discount curve) come from the swap; the only additional inputs are the
    expiry date, strike, vol surface, and settlement style.

    Pre-expiry NPV
    --------------
        NPV = black76(F, K, σ, df_expiry, T, is_payer) × notional × A

    where:
      F          = par swap rate  =  PV(floating leg) / A
      K          = swaption strike
      σ          = IRVol.get_vol(K − F,  T,  swap_tenor)
      df_expiry  = DF(val_date → expiry_date)
      T          = year_fraction(val_date, expiry_date)
      A          = Σ accrual_i × DF(t_i)   [fixed leg, future periods]

    Post-expiry NPV
    ---------------
    - Cash settled:     zero on all paths
    - Physical settled: max(underlying swap NPV, 0)
                        (paths that are in-the-money exercise into the swap;
                        out-of-the-money paths are floored at zero)

    Parameters
    ----------
    name : str
        Trade identifier.
    underlying_swap : IRSwap
        The underlying interest rate swap.  For a payer swaption set the
        swap with receive_leg = floating and pay_leg = fixed; for a
        receiver swaption swap the legs.
    expiry_date : date
        Date on which the option expires.
    strike : float
        Fixed-rate strike of the swaption.
    vol_surface : IRVol
        IR vol surface.  Queried with moneyness = K − F.
    is_payer : bool
        True for a payer swaption (holder pays fixed).  Default True.
    settlement_style : str
        "cash" or "physical".  Default "cash".
    forward_shift : float
        Displacement s for the shifted-lognormal ("shifted Black-76") model.
        Both the forward and the strike are raised by s inside the option
        formula, so a negative par swap rate can still be modelled
        lognormally.  Defaults to 0.0 (standard Black-76).

        The shift is confined to the option formula.  Moneyness is
        ``(K + s) - (F + s) = K - F`` and the exercise test ``F > K`` is
        likewise unchanged by a common displacement, so the vol lookup, the
        exercise decision and the annuity all see the un-shifted values.
    """

    def __init__(
        self,
        name: str,
        underlying_swap: IRSwap,
        expiry_date: date,
        strike: float,
        vol_surface: IRVol,
        is_payer: bool = True,
        settlement_style: str = "cash",
        forward_shift: float = 0.0,
    ):
        super().__init__(name)
        if settlement_style.lower() not in ("cash", "physical"):
            raise ValueError(
                f"settlement_style must be 'cash' or 'physical', got {settlement_style!r}"
            )
        if forward_shift < 0.0:
            raise ValueError(
                f"forward_shift must be non-negative, got {forward_shift!r}"
            )

        self.underlying_swap = underlying_swap
        self.expiry_date = expiry_date
        self.strike = strike
        self.vol_surface = vol_surface
        self.is_payer = is_payer
        self.settlement_style = settlement_style.lower()
        self.forward_shift = forward_shift

        # Populated by precompute() for physical settlement; None until then
        self._exercise_mask: np.ndarray | None = None

        # Swap tenor for vol surface lookup — fixed at construction
        sc = underlying_swap.schedule_config
        self._swap_tenor_yrs = float(
            sc.curve_day_counter.yearFraction(
                to_ql_date(underlying_swap.effective_date),
                to_ql_date(underlying_swap.maturity_date),
            )
        )

        # Identify fixed vs floating legs from the underlying swap
        swap = underlying_swap
        if swap.receive_leg.leg_type == LegType.FIXED:
            self._fixed_leg      = swap.receive_leg
            self._fixed_schedule = swap.receive_schedule
            self._float_leg      = swap.pay_leg
            self._float_schedule = swap.pay_schedule
        else:
            self._fixed_leg      = swap.pay_leg
            self._fixed_schedule = swap.pay_schedule
            self._float_leg      = swap.receive_leg
            self._float_schedule = swap.receive_schedule

    # ------------------------------------------------------------------
    # Precompute — exercise decision for physical settlement
    # ------------------------------------------------------------------

    def precompute(
        self,
        market_states: list[dict[str, RiskFactorSlice]],
        dates: list[date],
    ) -> None:
        """Compute and store the per-path exercise mask for physical settlement.

        Finds the last simulation date on or before expiry_date, evaluates
        the par swap rate F at that date, and records which paths are in-the-money:
          - payer swaption: exercised when F > K
          - receiver swaption: exercised when F < K

        Post-expiry scenario_npvs multiplies the swap NPV by this mask, so
        paths that did not exercise always report zero exposure.
        """
        if self.settlement_style != "physical":
            return

        # Last sim date <= expiry_date (the date the exercise decision is made)
        expiry_idx = None
        for i, d in enumerate(dates):
            if d <= self.expiry_date:
                expiry_idx = i

        if expiry_idx is None:
            return

        expiry_sim_date = dates[expiry_idx]
        expiry_state = market_states[expiry_idx]

        disc_slice: CurveSlice = expiry_state[self.underlying_swap.discount_curve_name]
        n_paths = disc_slice.values.shape[0]

        discount_curve = YieldCurve(
            year_fracs=disc_slice.tenors,
            rates=disc_slice.values,
            interpolator=self.underlying_swap.interpolator,
        )

        F, _ = self._forward_rate_and_annuity(
            expiry_sim_date, discount_curve, expiry_state, n_paths,
        )

        if self.is_payer:
            self._exercise_mask = (F > self.strike).astype(float)
        else:
            self._exercise_mask = (F < self.strike).astype(float)

    # ------------------------------------------------------------------
    # Reset / fixing interface — delegate to the underlying swap
    # ------------------------------------------------------------------

    def get_reset_dates(self) -> list[tuple[date, str, date, date]]:
        return self.underlying_swap.get_reset_dates()

    def compute_fixings(
        self,
        resets: list[tuple[date, str, date, date]],
        time_slice: dict[str, RiskFactorSlice],
        scenario_date: date,
    ) -> dict[tuple[str, date], np.ndarray]:
        return self.underlying_swap.compute_fixings(resets, time_slice, scenario_date)

    def compute_cf_increment(
        self,
        curve_name: str,
        t_from: date,
        t_to: date,
        time_slice: dict[str, RiskFactorSlice],
        *,
        curve_date: date | None = None,
    ) -> np.ndarray:
        """Delegate the overnight compound-factor step to the underlying swap.

        Required for overnight-compounding (OIS) legs.  The ExposureEngine
        duck-types on this method to decide whether an ``is_overnight`` reset
        is accumulated as a compound factor or fixed once as a simple forward
        rate.  Without it a swaption whose underlying has an OIS leg silently
        falls through to the LIBOR path, which stores a *rate* under the same
        fixings key where ``leg_pv`` expects a *compound factor* — producing
        wildly wrong post-exercise swap values.
        """
        return self.underlying_swap.compute_cf_increment(
            curve_name, t_from, t_to, time_slice, curve_date=curve_date,
        )

    # ------------------------------------------------------------------
    # Par swap rate and annuity
    # ------------------------------------------------------------------

    def _forward_rate_and_annuity(
        self,
        val_date: date,
        discount_curve: YieldCurve,
        market_state: dict[str, RiskFactorSlice],
        n_paths: int,
    ) -> tuple[np.ndarray, np.ndarray]:
        """Compute the par swap rate F and annuity A over future periods.

        Uses the discount-factor approach for the floating leg PV:
            coupon_pv_i = (DF_fcast(t_start) / DF_fcast(t_end) - 1) × DF_disc(t_end)
        plus any additive spread on the floating leg.
        """
        sc = self.underlying_swap.schedule_config

        # --- Annuity from fixed leg ---
        future_fixed = filter_future_periods(self._fixed_schedule, val_date)
        if not future_fixed:
            return np.zeros(n_paths), np.zeros(n_paths)

        _, _, t_pays_fx, accruals_fx = compute_period_year_fractions(
            future_fixed, val_date, sc.curve_day_counter,
        )

        # Annuity discounts at the PAYMENT date, which can differ from the
        # accrual end date when the schedule carries a payment lag.
        annuity = np.zeros(n_paths)
        for tau, t_p in zip(accruals_fx, t_pays_fx):
            annuity += float(tau) * discount_curve.discount_factor(float(t_p))

        # --- Floating leg PV ---
        future_float = filter_future_periods(self._float_schedule, val_date)
        if not future_float:
            return np.zeros(n_paths), annuity

        t_starts_fl, t_ends_fl, t_pays_fl, accruals_fl = compute_period_year_fractions(
            future_float, val_date, sc.curve_day_counter,
        )

        float_slice: CurveSlice = market_state[self._float_leg.curve_name]
        float_curve = YieldCurve(
            year_fracs=float_slice.tenors,
            rates=float_slice.values,
            interpolator=self.underlying_swap.interpolator,
        )

        spread = self._float_leg.spread  # float, default 0.0

        float_pv = np.zeros(n_paths)
        for tau, t_s, t_e, t_p in zip(
            accruals_fl, t_starts_fl, t_ends_fl, t_pays_fl,
        ):
            ts, te, tp = float(t_s), float(t_e), float(t_p)
            # Forward rate spans the ACCRUAL period; discounting uses the
            # PAYMENT date.
            df_fcast_s = float_curve.discount_factor(max(ts, 0.0))
            df_fcast_e = float_curve.discount_factor(te)
            df_disc_p  = discount_curve.discount_factor(tp)
            safe_e = np.where(np.abs(df_fcast_e) > 1e-12, df_fcast_e, 1e-12)
            float_pv += (df_fcast_s / safe_e - 1.0) * df_disc_p
            if spread:
                float_pv += float(tau) * spread * df_disc_p

        safe_annuity = np.where(annuity > 1e-12, annuity, 1.0)
        return float_pv / safe_annuity, annuity

    # ------------------------------------------------------------------
    # Pricing
    # ------------------------------------------------------------------

    def scenario_npvs(
        self,
        val_date: date,
        market_state: dict[str, RiskFactorSlice],
        fixings: dict[tuple[str, date], np.ndarray] | None = None,
        rng: np.random.Generator | None = None,
    ) -> np.ndarray:
        disc_slice: CurveSlice = market_state[self.underlying_swap.discount_curve_name]
        n_paths = disc_slice.values.shape[0]

        # --- Post-expiry ---
        if val_date > self.expiry_date:
            if self.settlement_style == "physical":
                swap_npv = self.underlying_swap.scenario_npvs(
                    val_date, market_state, fixings=fixings,
                )
                if self._exercise_mask is not None:
                    # Exercised paths carry full swap NPV (positive or negative);
                    # non-exercised paths are always zero.
                    return swap_npv * self._exercise_mask
                # Fallback if precompute was not called (e.g. standalone use)
                return np.maximum(swap_npv, 0.0)
            return np.zeros(n_paths)

        # Discount curve
        discount_curve = YieldCurve(
            year_fracs=disc_slice.tenors,
            rates=disc_slice.values,
            interpolator=self.underlying_swap.interpolator,
        )

        sc = self.underlying_swap.schedule_config
        T = float(
            sc.curve_day_counter.yearFraction(
                to_ql_date(val_date), to_ql_date(self.expiry_date),
            )
        )
        df_expiry = discount_curve.discount_factor(T)

        # Par swap rate and annuity
        F, annuity = self._forward_rate_and_annuity(
            val_date, discount_curve, market_state, n_paths,
        )

        # On the expiry date itself (T = 0) cache the exercise decision so that
        # post-expiry dates know which paths actually entered the swap.
        # This is the primary way the mask is set; precompute() is a fallback
        # for simulations whose time grid does not include the expiry date.
        if self.settlement_style == "physical" and val_date == self.expiry_date:
            self._exercise_mask = (
                (F > self.strike) if self.is_payer else (F < self.strike)
            ).astype(float)

        # Vol: moneyness = K − F, one value per path
        moneyness = self.strike - F
        vol = np.asarray(
            self.vol_surface.get_vol(moneyness, T, self._swap_tenor_yrs),
            dtype=float,
        )
        if vol.ndim == 0:
            vol = np.full(n_paths, float(vol))

        # Shifted-Black76: displace forward and strike by the same amount.
        # The displacement cancels in the intrinsic value (F+s) - (K+s) = F - K,
        # so the degenerate T <= 0 / zero-vol branches are unaffected; only
        # log((F+s)/(K+s)) in d1/d2 sees the shift.
        shift = self.forward_shift
        if shift:
            forward_black = np.maximum(F + shift, _RATE_FLOOR)
            strike_black = max(self.strike + shift, _RATE_FLOOR)
        else:
            forward_black, strike_black = F, self.strike

        # Black-76 × notional × annuity
        option_price = black76_euro_option(
            forward=forward_black,
            strike=strike_black,
            vol=vol,
            df=df_expiry,
            T=T,
            is_call=self.is_payer,
        )

        return option_price * self.underlying_swap.notional * annuity
