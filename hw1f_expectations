    def _ois_daily_caplets(self) -> None:
        period_records = []
        daily_records = []

        for _, period in self.schedule.iterrows():
            period_start = period["StartDate"]
            period_end = period["EndDate"]
            pay_date = period["PayDate"]
            period_tau = period["YearFrac"]
            df_pay = self.discount_curve.get_discount_factor_for_date(pay_date)

            period_pv = 0.0
            for d_i, d_next in iter_overnight_periods(period_start, period_end, self.calendar):
                tau_i = self.forward_curve.rate_day_count_convention(d_i, d_next)
                f_day = self.forward_curve.get_simple_forward(d_i, d_next)
                moneyness = (self.strike - f_day) * 100
                f_s = f_day + self.forward_shift
                k_s = self.strike + self.forward_shift
                t_i = (
                    (d_i - self.valuation_date).days / 365.0
                    if self.valuation_date else 0.0
                )

                if t_i <= 0:
                    vol, d1, d2 = 0.0, np.nan, np.nan
                    opt_factor = (
                        max(f_day - self.strike, 0.0) * tau_i if self.cap
                        else max(self.strike - f_day, 0.0) * tau_i
                    )
                else:
                    vol = self.ir_vol.get_vol(moneyness, t_i, period_tau)
                    if vol <= 0 or f_s <= 0 or k_s <= 0:
                        d1, d2, opt_factor = np.nan, np.nan, 0.0
                    else:
                        d1 = (np.log(f_s / k_s) + 0.5 * vol**2 * t_i) / (vol * np.sqrt(t_i))
                        d2 = d1 - vol * np.sqrt(t_i)
                        if self.cap:
                            opt_factor = tau_i * (f_s * norm.cdf(d1) - k_s * norm.cdf(d2))
                        else:
                            opt_factor = tau_i * (k_s * norm.cdf(-d2) - f_s * norm.cdf(-d1))

                pv_day = self.notional * opt_factor * df_pay
                period_pv += pv_day

                daily_records.append({
                    "PeriodStart": period_start,
                    "PeriodEnd": period_end,
                    "PayDate": pay_date,
                    "DayStart": d_i,
                    "DayEnd": d_next,
                    "YearFrac": tau_i,
                    "ForwardRate": f_day,
                    "Strike": self.strike,
                    "Moneyness": moneyness,
                    "t_exp": t_i,
                    "Vol": vol,
                    "d1": d1,
                    "d2": d2,
                    "OptionFactor": opt_factor,
                    "DiscountFactor": df_pay,
                    "PV": pv_day,
                })
