
    # ------------------------------------------------------------------
    # Strike slope  ∂σ/∂moneyness  (used by digital cap/floor skew adj.)
    # ------------------------------------------------------------------

    def _slope_at_expiry_maturity(
        self,
        moneyness: float | np.ndarray,
        expiry: float,
        maturity: float,
    ) -> np.ndarray:
        """Local segment slope ∂σ/∂moneyness at an exact (expiry, maturity).

        Since the moneyness axis is interpolated linearly, the slope is the
        gradient of the bracketing segment — a step function, constant
        between surface nodes and discontinuous at them.  Flat extrapolation
        outside the node range implies a slope of zero there.
        """
        m_nodes, v_nodes = self._surface[maturity][expiry]
        m = np.asarray(moneyness, dtype=float)

        if m_nodes.size < 2:
            return np.zeros_like(m)

        # Index of the segment [m_nodes[i], m_nodes[i+1]] containing m
        i = np.clip(
            np.searchsorted(m_nodes, m, side="right") - 1, 0, m_nodes.size - 2,
        )
        seg = (v_nodes[i + 1] - v_nodes[i]) / (m_nodes[i + 1] - m_nodes[i])

        outside = (m < m_nodes[0]) | (m > m_nodes[-1])
        return np.where(outside, 0.0, seg)

    def _slope_at_maturity(
        self,
        moneyness: float | np.ndarray,
        swaption_expiry: float,
        maturity: float,
    ) -> np.ndarray:
        """Linear interp in swaption_expiry of the moneyness slope."""
        expiries = np.array(sorted(self._surface[maturity].keys()))
        idx = int(np.searchsorted(expiries, swaption_expiry))

        if idx == 0:
            return self._slope_at_expiry_maturity(moneyness, float(expiries[0]), maturity)
        if idx == len(expiries):
            return self._slope_at_expiry_maturity(moneyness, float(expiries[-1]), maturity)

        e2 = float(expiries[idx])
        if np.isclose(swaption_expiry, e2):
            return self._slope_at_expiry_maturity(moneyness, e2, maturity)

        e1 = float(expiries[idx - 1])
        s1 = self._slope_at_expiry_maturity(moneyness, e1, maturity)
        s2 = self._slope_at_expiry_maturity(moneyness, e2, maturity)
        w = (swaption_expiry - e1) / (e2 - e1)
        return s1 + w * (s2 - s1)

    def get_slope(
        self,
        moneyness: float | np.ndarray,
        swaption_expiry: float,
        swap_maturity: float,
    ) -> float | np.ndarray:
        """Return ∂σ/∂moneyness at the queried surface point.

        The derivative of :meth:`get_vol` with respect to its moneyness
        argument.  Because both the expiry and maturity axes are blended
        linearly, the slope of the blend equals the blend of the slopes, so
        this follows exactly the same maturity → expiry → moneyness
        traversal as :meth:`get_vol`.

        Units follow the input data: the returned slope is per unit of
        whatever moneyness convention the surface was built with.

        Parameters
        ----------
        moneyness : float or array
            Strike moneyness (convention matches the input data).
        swaption_expiry : float
            Time to expiry in year fractions.
        swap_maturity : float
            Underlying swap (or caplet) maturity in year fractions.

        Returns
        -------
        float or np.ndarray
            Slope, same shape as *moneyness*.
        """
        maturities = self._maturities
        idx = int(np.searchsorted(maturities, swap_maturity))

        if idx == 0:
            return self._slope_at_maturity(moneyness, swaption_expiry, float(maturities[0]))
        if idx == len(maturities):
            return self._slope_at_maturity(moneyness, swaption_expiry, float(maturities[-1]))

        m2 = float(maturities[idx])
        if np.isclose(swap_maturity, m2):
            return self._slope_at_maturity(moneyness, swaption_expiry, m2)

        m1 = float(maturities[idx - 1])
        s1 = self._slope_at_maturity(moneyness, swaption_expiry, m1)
        s2 = self._slope_at_maturity(moneyness, swaption_expiry, m2)
        w = (swap_maturity - m1) / (m2 - m1)
        return s1 + w * (s2 - s1)
