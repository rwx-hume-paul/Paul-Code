def prev_business_day(target_date: date, calendar: str = "TARGET") -> date:
    """Returns the business day immediately preceding target_date."""
    if "." in calendar:
        parts = calendar.split(".")
        calendar_class = getattr(ql, parts[0])
        market = getattr(calendar_class, parts[1])
        ql_calendar = calendar_class(market)
    else:
        ql_calendar = getattr(ql, calendar)()
    ql_date = ql.Date(target_date.day, target_date.month, target_date.year)
    prev = ql_date - 1
    prev = ql_calendar.adjust(prev, ql.Preceding)
    return date(prev.year(), prev.month(), prev.dayOfMonth())
