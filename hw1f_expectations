"""
.. deprecated::
    CubePricer is superseded by :class:`pricing.exposure_engine.ExposureEngine`.
    Retained for backward compatibility. Migrate to ExposureEngine + NettingSet
    for the full XVA pipeline.
"""
from __future__ import annotations

import warnings
from datetime import date
from pathlib import Path

import numpy as np
import pandas as pd

from market_data.scenario_cube import ScenarioCube


class CubePricer:
    """
    Prices an instrument across all dates in a ScenarioCube.

    Parameters
    ----------
    scenario_cube : ScenarioCube
        The simulated scenario cube containing factor paths.
    instrument
        The instrument to price. Must implement a pricing interface
        that the calculate_mtm method can call per simulation date.
    """

    def __init__(self, scenario_cube: ScenarioCube, instrument):
        warnings.warn(
            "CubePricer is deprecated. Use ExposureEngine + NettingSet instead.",
            DeprecationWarning,
            stacklevel=2,
        )
        self.cube = scenario_cube
        self.instrument = instrument

    def calculate_mtm(self) -> dict[date, dict[int, float]]:
        """
        Mark-to-market the instrument at each date in the scenario cube,
        across all simulated paths.

        Category B resets (floating periods whose reset date falls before
        the current scenario date) are fixed using the forward curve from
        the latest scenario date on or before the reset date.  Fixings
        are cached so each reset is computed at most once.

        Reset handling is delegated to :class:`ExposureEngine` rather than
        reimplemented here, so both pricers agree.  That matters for
        overnight-compounding (OIS) legs, whose resets are 5-tuples carrying
        an ``is_overnight`` flag and whose CF_realized must be accumulated
        across time steps rather than fixed once — logic this class never
        had of its own.

        Returns
        -------
        dict[date, dict[int, float]]
            {simulation_date: {path_index: npv}}
        """
        # Imported lazily to keep this deprecated module's import graph flat.
        from pricing.exposure_engine import ExposureEngine

        results: dict[date, dict[int, float]] = {}

        fixings_helper = ExposureEngine(cube=self.cube)
        fixing_cache: dict[tuple, np.ndarray] = {}
        scenario_dates = list(self.cube.dates)

        # Honour the Instrument.precompute hook, as ExposureEngine does.
        all_states = [
            self.cube.get_time_slice(t) for t in range(self.cube.n_times)
        ]
        self.instrument.precompute(all_states, scenario_dates)

        for t_idx in range(self.cube.n_times):
            sim_date = self.cube.dates[t_idx]

            fixings = fixings_helper._build_fixings(
                self.instrument, sim_date, scenario_dates, fixing_cache,
            )

            market_state = all_states[t_idx]

            path_npvs = self.instrument.scenario_npvs(
                sim_date, market_state, fixings=fixings if fixings else None,
            )

            results[sim_date] = {
                p_idx: float(path_npvs[p_idx])
                for p_idx in range(self.cube.n_paths)
            }

        return results

    def calculate_mtm_df(self) -> pd.DataFrame:
        """
        Mark-to-market the instrument and return a DataFrame.

        Rows are indexed by simulation date, columns are simulation
        (path) numbers.
        """
        return pd.DataFrame(self.calculate_mtm()).T

    def mtm_to_csv(self, filepath: str | Path) -> None:
        """
        Write MTM results to CSV.

        Output format::

            date, 0, 1, ...
            2025-07-28, 12345.67, 13456.78, ...
            2026-07-28, 11234.56, 12345.67, ...

        Parameters
        ----------
        filepath : path for the output CSV file.
        """
        self.calculate_mtm_df().to_csv(filepath, index_label="date")
