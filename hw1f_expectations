import numpy as np
from scipy.interpolate import PchipInterpolator


class IRVol:
    """Interest rate volatility surface for swaptions and caps/floors.

    Input DataFrame must have columns: Moneyness, Expiry, Maturity, Vol.
    Expiry and Maturity are year fractions. Moneyness convention is caller-defined
    (absolute strike, log-moneyness, offset from ATM, etc.).

    Interpolation order: Maturity → Expiry → Moneyness.
    Maturity and Expiry are always linear on volatility, with flat extrapolation outside
    the surface range. Moneyness (strike) is linear by default; pass strike_interp='hermite'
    to interpolate the strike dimension with a monotone cubic Hermite (PCHIP) spline on
    volatility instead, still with flat extrapolation beyond the node range.
    """

    def __init__(self, vol_data: list, strike_interp: str = "linear") -> None:
        if strike_interp not in ("linear", "hermite"):
            raise ValueError(f"strike_interp must be 'linear' or 'hermite', got {strike_interp!r}")
        self.strike_interp = strike_interp

        arr = np.asarray(vol_data, dtype=np.float64)  # (N, 4): moneyness, expiry, maturity, vol
        self._maturities = np.unique(arr[:, 2])

        # {maturity: {expiry: (moneyness_nodes, vol_nodes, hermite_spline_or_None)}}
        self._surface: dict = {}

        for mat in self._maturities:
            mat_rows = arr[np.isclose(arr[:, 2], mat)]
            expiries = np.unique(mat_rows[:, 1])
            self._surface[float(mat)] = {}
            for exp in expiries:
                exp_rows = mat_rows[np.isclose(mat_rows[:, 1], exp)]
                order = np.argsort(exp_rows[:, 0])
                m_nodes = exp_rows[order, 0]
                v_nodes = exp_rows[order, 3]
                hermite = (
                    PchipInterpolator(m_nodes, v_nodes)
                    if self.strike_interp == "hermite" and len(m_nodes) > 1
                    else None
                )
                self._surface[float(mat)][float(exp)] = (m_nodes, v_nodes, hermite)

    def _vol_at_expiry_maturity(self, moneyness: float, expiry: float, maturity: float) -> float:
        m_nodes, v_nodes, hermite = self._surface[maturity][expiry]
        if hermite is not None:
            # Clamp to the node range first so we get flat extrapolation, matching linear mode,
            # rather than the polynomial's own (potentially divergent) extrapolation.
            m_clamped = np.clip(moneyness, m_nodes[0], m_nodes[-1])
            return float(hermite(m_clamped))
        return float(np.interp(moneyness, m_nodes, v_nodes))

    def _slope_at_expiry_maturity(self, moneyness: float, expiry: float, maturity: float) -> float:
        """∂vol/∂moneyness at one (expiry, maturity) node — the Hermite spline's derivative
        in 'hermite' mode, or the local piecewise-linear segment slope in 'linear' mode. 0
        outside the node range (flat extrapolation) or when there's only one strike (flat
        vol, so slope is 0 regardless of mode)."""
        m_nodes, v_nodes, hermite = self._surface[maturity][expiry]
        if moneyness < m_nodes[0] or moneyness > m_nodes[-1]:
            return 0.0
        if hermite is not None:
            return float(hermite.derivative()(moneyness))
        if len(m_nodes) < 2:
            return 0.0
        idx = int(np.searchsorted(m_nodes, moneyness, side="right"))
        idx = min(max(idx, 1), len(m_nodes) - 1)
        m0, m1 = m_nodes[idx - 1], m_nodes[idx]
        v0, v1 = v_nodes[idx - 1], v_nodes[idx]
        return float((v1 - v0) / (m1 - m0))

    def _vol_at_maturity(self, moneyness: float, swaption_expiry: float, maturity: float) -> float:
        expiries = np.array(sorted(self._surface[maturity].keys()))
        idx = int(np.searchsorted(expiries, swaption_expiry))

        if idx == 0:
            return self._vol_at_expiry_maturity(moneyness, float(expiries[0]), maturity)
        if idx == len(expiries):
            return self._vol_at_expiry_maturity(moneyness, float(expiries[-1]), maturity)

        e2 = float(expiries[idx])
        if np.isclose(swaption_expiry, e2):
            return self._vol_at_expiry_maturity(moneyness, e2, maturity)

        e1 = float(expiries[idx - 1])
        v1 = self._vol_at_expiry_maturity(moneyness, e1, maturity)
        v2 = self._vol_at_expiry_maturity(moneyness, e2, maturity)
        w = (swaption_expiry - e1) / (e2 - e1)
        return v1 + w * (v2 - v1)

    def _slope_at_maturity(self, moneyness: float, swaption_expiry: float, maturity: float) -> float:
        """Blends the per-expiry strike-slopes the same (linear) way _vol_at_maturity blends
        vol values — valid because expiry interpolation is a linear (affine) combination
        whose weights don't depend on moneyness, so differentiating w.r.t. moneyness commutes
        with it."""
        expiries = np.array(sorted(self._surface[maturity].keys()))
        idx = int(np.searchsorted(expiries, swaption_expiry))

        if idx == 0:
            return self._slope_at_expiry_maturity(moneyness, float(expiries[0]), maturity)
        if idx == len(expiries):
            return self._slope_at_expiry_maturity(moneyness, float(expiries[-1]), maturity)

        e2 = float(expiries[idx])
        if np.isclose(swaption_expiry, e2):
            return self._slope_at_expiry_maturity(moneyness, e2, maturity)

        e1 = float(expiries[idx - 1])
        s1 = self._slope_at_expiry_maturity(moneyness, e1, maturity)
        s2 = self._slope_at_expiry_maturity(moneyness, e2, maturity)
        w = (swaption_expiry - e1) / (e2 - e1)
        return s1 + w * (s2 - s1)

    def get_vol(self, moneyness: float, swaption_expiry: float, swap_maturity: float) -> float:
        """Return interpolated swaption / cap / floor volatility.

        Parameters
        ----------
        moneyness : float
            Strike moneyness (convention matches the input data).
        swaption_expiry : float
            Time to swaption expiry in year fractions.
        swap_maturity : float
            Underlying swap (or caplet) maturity in year fractions.

        Returns
        -------
        float
            Implied volatility.
        """
        maturities = self._maturities
        idx = int(np.searchsorted(maturities, swap_maturity))

        if idx == 0:
            return self._vol_at_maturity(moneyness, swaption_expiry, float(maturities[0]))
        if idx == len(maturities):
            return self._vol_at_maturity(moneyness, swaption_expiry, float(maturities[-1]))

        m2 = float(maturities[idx])
        if np.isclose(swap_maturity, m2):
            return self._vol_at_maturity(moneyness, swaption_expiry, m2)

        m1 = float(maturities[idx - 1])
        v1 = self._vol_at_maturity(moneyness, swaption_expiry, m1)
        v2 = self._vol_at_maturity(moneyness, swaption_expiry, m2)
        w = (swap_maturity - m1) / (m2 - m1)
        return v1 + w * (v2 - v1)

    def get_slope(self, moneyness: float, swaption_expiry: float, swap_maturity: float) -> float:
        """Return the instantaneous strike-dimension slope (∂vol/∂moneyness) at the given
        point, blended across expiry/maturity the same linear way get_vol blends vol
        values. Works in both strike_interp modes: the Hermite spline's derivative in
        'hermite' mode, or the local piecewise-linear segment slope in 'linear' mode (a
        step function in moneyness — constant between strike nodes, discontinuous at them).

        Parameters
        ----------
        moneyness : float
            Strike moneyness (convention matches the input data).
        swaption_expiry : float
            Time to swaption expiry in year fractions.
        swap_maturity : float
            Underlying swap (or caplet) maturity in year fractions.

        Returns
        -------
        float
            d(vol)/d(moneyness), i.e. the local slope of the strike smile.
        """
        maturities = self._maturities
        idx = int(np.searchsorted(maturities, swap_maturity))

        if idx == 0:
            return self._slope_at_maturity(moneyness, swaption_expiry, float(maturities[0]))
        if idx == len(maturities):
            return self._slope_at_maturity(moneyness, swaption_expiry, float(maturities[-1]))

        m2 = float(maturities[idx])
        if np.isclose(swap_maturity, m2):
            return self._slope_at_maturity(moneyness, swaption_expiry, m2)

        m1 = float(maturities[idx - 1])
        s1 = self._slope_at_maturity(moneyness, swaption_expiry, m1)
        s2 = self._slope_at_maturity(moneyness, swaption_expiry, m2)
        w = (swap_maturity - m1) / (m2 - m1)
        return s1 + w * (s2 - s1)
