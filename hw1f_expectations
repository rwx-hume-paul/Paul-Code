def integrate_term_structure(t, tenors, values, exp_power):
    """
    Numeric integral of exp(exp_power*s) * values(s) over s in [0, t]
    where values(s) is piecewise-linear defined on (tenors, values).
    """
    if t <= 0.0:
        return 0.0

    # grid = union of tenors and [0, t], clipped to [0,t]
    grid = np.array(sorted(set(np.concatenate([tenors, [0.0, t]]))))
    grid = grid[(grid >= 0.0) & (grid <= t)]
    if grid.size < 2:
        return 0.0

    vals = np.interp(grid, tenors, values, left=values[0], right=values[-1])
    integrand = np.exp(exp_power * grid) * vals
    return np.trapz(integrand, grid)

def hw2_var_termstructured(
    tenors, t, a_tenors, a_rates,
    alpha1, sigma1_tenors, sigma1_vals,
    alpha2, sigma2_tenors, sigma2_vals,
    rho
):
    """
    Theoretical variance of Y=exp(-tau*R(t,tau)) for HW2 with term-structured sigmas.
    """
    # P(0,T)/P(0,t)
    z0 = lambda u: np.interp(u, a_tenors, a_rates, left=a_rates[0], right=a_rates[-1])
    lhs = np.array([np.exp(-z0(t + tau) * (t + tau) + z0(t) * t) for tau in tenors])

    # J1, J2, K12
    J1 = integrate_term_structure(t, sigma1_tenors, sigma1_vals**2, exp_power=2.0*alpha1)
    J2 = integrate_term_structure(t, sigma2_tenors, sigma2_vals**2, exp_power=2.0*alpha2)

    # cross integral uses sigma1*sigma2
    # build a common grid for interpolation
    grid = np.array(sorted(set(np.concatenate([sigma1_tenors, sigma2_tenors, [0.0, t]]))))
    grid = grid[(grid >= 0.0) & (grid <= t)]
    s1 = np.interp(grid, sigma1_tenors, sigma1_vals, left=sigma1_vals[0], right=sigma1_vals[-1])
    s2 = np.interp(grid, sigma2_tenors, sigma2_vals, left=sigma2_vals[0], right=sigma2_vals[-1])
    K12 = np.trapz(np.exp((alpha1 + alpha2) * grid) * (s1 * s2), grid)

    # B(tau)
    b1 = (1.0 - np.exp(-alpha1 * tenors)) / alpha1
    b2 = (1.0 - np.exp(-alpha2 * tenors)) / alpha2

    # variance of b1*X1 + b2*X2 (X_i = e^{-alpha_i t} Y_i)
    v = (b1**2) * np.exp(-2.0*alpha1*t) * J1 \
        + (b2**2) * np.exp(-2.0*alpha2*t) * J2 \
        + 2.0 * b1 * b2 * np.exp(-(alpha1+alpha2)*t) * rho * K12

    return lhs**2 * (np.exp(v) - 1.0)



var_model = hw2_var_termstructured(
    tenors, t,
    a_tenors, a_rates,
    alpha1, sigma1_tenors, sigma1_vals,
