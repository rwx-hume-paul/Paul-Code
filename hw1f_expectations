        self.scen_grid = time_grid.scenario_grid
        # Lagged scenario grid: row k holds the scenario from t_{k-1} rather
        # than t_k.  This makes the drift for each period [t_{k-1}, t_k] use
        # the rate curve that was known at the START of the period, which is
        # equivalent to the standard explicit (forward-Euler) GBM discretisation:
        #
        #   S(t_k) = S(t_{k-1}) * F(t_{k-1}, t_k) * exp(vol correction)
        #
        # Without the lag, the rate for period [t_{k-1}, t_k] is read from the
        # scenario at t_k (end of period).  For short steps this makes no
        # difference, but for a coarse grid the end-of-period long rate is a
        # proxy for the NEXT period's forward rate rather than the current
        # period's, introducing a systematic upward bias in E[S(T)].  The lag
        # eliminates this: the 2-step case reverts to the initial (T=0) zero
        # curve for the full horizon, restoring E[S(T)] = F(0,T).
        self.lagged_scen_grid = np.concatenate(
            [self.scen_grid[:1], self.scen_grid[:-1]], axis=0
        )





