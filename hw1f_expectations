# One caplet per rolling 3M accrual period, each on the simple JIBAR-3M
# forward fixing at its own period start (IBOR mode).  The trade started in
# 2022, so at val_date the 2026-03-31 -> 2026-06-30 period is already in
# motion: its expiry is negative and it prices at intrinsic off the realized
# fixing the ExposureEngine supplies.
jibar_leg = CashflowLeg(
    LegType.FLOATING,
    frequency=3,
    curve_name="JIBAR-3M",
    forward_business_convention="Following",
)

cap = CapFloor(
    name="ZAR_JIBAR_CAP",
    effective_date=date(2022, 3, 31),
    maturity_date=date(2027, 3, 31),
    notional=-172_000_000,          # negative = short the cap
    strike=0.0715,
    leg=jibar_leg,
    discount_curve_name="ZAR-SWAP",
    interpolator=hermite_rt_interp,
    vol_surface=vol_surface,
    is_cap=True,
    cap_vol_maturity=0.25,          # caplet-tenor axis of the vol surface
    include_sim_date_cashflows=True,
)

# Per-caplet diagnostics at the valuation date (averaged across paths) —
# forward, moneyness, expiry, vol, d1/d2, option factor, PV and vega per period.
breakdown = cap.caplet_breakdown(val_date, cube.get_time_slice(0))
print(breakdown.to_string(index=False))
