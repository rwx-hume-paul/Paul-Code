
    # ---- Terminal distribution plots (penultimate date) ----
    # The final simulation date is always 0 (past maturity), so we use [-2].
    terminal_date = mean1.index[-2]
    rf_terminal   = d1.loc[terminal_date].dropna().values
    val_terminal  = d2.loc[terminal_date].dropna().values

    for values, label, colour, fname in [
        (rf_terminal,  f"RiskFlow — {terminal_date}",   "steelblue",  "terminal_dist_riskflow.png"),
        (val_terminal, f"Validation — {terminal_date}", "darkorange", "terminal_dist_validation.png"),
    ]:
        fig, ax = plt.subplots(figsize=(9, 5))
        ax.hist(values, bins=50, color=colour, edgecolor="white", linewidth=0.4)
        ax.axvline(values.mean(), color="black", linestyle="--", linewidth=1.2,
                   label=f"Mean: {values.mean():,.0f}")
        ax.set_xlabel("MTM Value")
        ax.set_ylabel("Path Count")
        ax.set_title(f"Terminal MTM Distribution — {label}")
        ax.legend()
        ax.grid(axis="y", alpha=0.4)
        fig.tight_layout()
        fig.savefig(folder / fname)
        plt.close(fig)
